{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/operational-ai-agents/finding.schema.json",
  "title": "Structured finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "agent_id",
    "category",
    "severity",
    "confidence",
    "description",
    "input_refs",
    "evidence_refs"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "description": {
      "type": "string"
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_action": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
