{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "timestamp",
    "execution_id",
    "agent_id",
    "event",
    "status",
    "tool",
    "input_refs",
    "output",
    "duration_ms",
    "confidence",
    "evidence_refs",
    "human_decision"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "execution_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "event": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "tool": {
      "type": ["string", "null"]
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output": {
      "type": ["object", "null"]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_decision": {
      "enum": [null, "PENDING", "ACCEPTED", "REJECTED", "ESCALATED"]
    }
  },
  "additionalProperties": false
}
